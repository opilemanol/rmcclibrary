    return (\par
        <div className="space-y-6 pb-20 md:pb-6">\par
             <div className="flex items-center justify-between">\par
                <div className="flex items-center gap-4">\par
                    <Button variant="outline" size="icon" asChild>\par
                        <Link href="/">\par
                            <ArrowLeft className="h-4 w-4" />\par
                        </Link>\par
                    </Button>\par
                    <h1 className="text-2xl font-headline font-bold text-foreground">\par
                        Baptism Course\par
                    </h1>\par
                </div>\par
            </div>\par
            \par
            <Card>\par
                <CardHeader>\par
                    <CardTitle>Course Modules</CardTitle>\par
                    <CardDescription>Select a module to view its content.</CardDescription>\par
                </CardHeader>\par
                <CardContent>\par
                    <Accordion type="single" collapsible className="w-full space-y-2">\par
                        \{courseModules.map((module) => (\par
                            <AccordionItem value=\{`item-$\{module.id\}`\} key=\{module.id\} className="border-b-0 border border-primary rounded-lg">\par
