                                    \{module.title\}\par
                                </AccordionTrigger>\par
                                <AccordionContent className="space-y-2 px-4">\par
                                  <p className="text-muted-foreground italic">\{module.description\}</p>\par
                                  <div className="prose prose-sm max-w-none">\{module.content\}</div>\par
                                </AccordionContent>\par
                            </AccordionItem>\par
                        ))\}\par
                    </Accordion>\par
                </CardContent>\par
            </Card>\par
        </div>\par
    );\par
\}\f1\lang9\par
