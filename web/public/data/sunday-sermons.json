  "sermons": [
    {
      "id": "sermon-001",
      "week": 1,
      "title": "Sample Sermon: Hope That Endures",
      "theme": "Steadfast hope in difficult seasons",
      "preacher": "Sample outline — preacher to be supplied",
      "scripture": "Romans 5:1–5; Psalm 42",
      "keyVerse": "Romans 5:5",
      "introduction": "This sample outline offers a structure for a sermon on hope without claiming to be an official church message.",
      "mainPoints": [
        {
          "heading": "Hope can coexist with honest grief",
          "content": "The Psalms make room for lament and trust. Honest prayer does not require hiding pain.",
          "scriptureReferences": [
            "Psalm 42"
          ]
        },
        {
          "heading": "Endurance grows through support and practice",
          "content": "Hardship is not good in itself, but people can develop endurance and compassion while facing it.",
          "scriptureReferences": [
            "Romans 5:3–4"
          ]
        },
        {
          "heading": "Offer hope through presence",
          "content": "Practical care, listening and appropriate help can make hope tangible to a neighbor.",
          "scriptureReferences": [
            "Romans 12:15"
          ]
        }
      ],
      "illustration": "Invite the congregation to recall a time when another person listened without rushing to fix everything.",
      "practicalApplication": "Contact someone who may feel isolated and ask what kind of support would be helpful.",
      "conclusion": "Hope is not denial; it is a reason to keep seeking what is good together.",
      "prayer": "God of hope, comfort those who grieve and make us attentive companions to one another. Amen.",
      "contentStatus": "sample"
    },
    {
      "id": "sermon-002",
      "week": 2,
      "title": "Sample Sermon: A Neighbor in Need",
      "theme": "Mercy expressed through practical care",
      "preacher": "Sample outline — preacher to be supplied",
      "scripture": "Luke 10:25–37; Micah 6:8",
      "keyVerse": "Micah 6:8",
      "introduction": "This demonstration outline invites reflection on compassion that crosses familiar boundaries.",
      "mainPoints": [
        {
          "heading": "Notice the person in front of you",
          "content": "Compassion begins when we pay attention rather than rushing past another person’s need.",
          "scriptureReferences": [
            "Luke 10:33"
          ]
        },
        {
          "heading": "Offer help that respects dignity",
          "content": "The Samaritan provides concrete support and makes arrangements for continued care.",
          "scriptureReferences": [
            "Luke 10:34–35"
          ]
        },
        {
          "heading": "Make mercy a shared practice",
          "content": "Communities can organize dependable care while respecting safety, consent and local expertise.",
          "scriptureReferences": [
            "Micah 6:8"
          ]
        }
      ],
      "illustration": "Describe a community sharing practical tasks to help a neighbor recover from a setback.",
      "practicalApplication": "Choose one safe, specific way to help in partnership with a person or trusted local service.",
      "conclusion": "Mercy becomes visible in attention, respect and consistent action.",
      "prayer": "God, help us recognize our neighbors and respond with wisdom and compassion. Amen.",
      "contentStatus": "sample"
    },
