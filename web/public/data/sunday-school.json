  "lessons": [
    {
      "id": "ss-001",
      "week": 1,
      "title": "Sample: Listening and Responding",
      "theme": "Practicing attentive faith",
      "scripture": "James 1:19–25; Luke 8:4–15",
      "memoryVerse": "James 1:22",
      "introduction": "This demonstration lesson explores the difference between hearing wise instruction and putting it into practice. It is an editable sample, not an official RMCC curriculum.",
      "lessonObjectives": [
        "Describe one way to listen attentively",
        "Identify a practical response to a biblical principle",
        "Encourage one another with respectful discussion"
      ],
      "lessonOutline": [
        "Listen before responding",
        "Receive teaching with humility",
        "Put understanding into practice"
      ],
      "lessonContent": "James connects listening, humility and action. A group can begin by naming the distractions that make careful listening difficult. Read the selected passages in a Bible translation chosen by the church. Discuss how listening changes the way we respond at home, at church and in the community. Invite learners to choose one small action they can practice this week.",
      "discussionQuestions": [
        "What helps you listen well?",
        "How can a group disagree respectfully?",
        "What is one practical response you can make this week?"
      ],
      "practicalApplication": "Choose one conversation this week where you will listen without interrupting, then respond thoughtfully.",
      "conclusion": "Faithful learning continues beyond a meeting when understanding becomes kind and responsible action.",
      "prayer": "God, help us listen with patience, learn with humility and put what is good into practice. Amen.",
      "contentStatus": "sample"
    },
    {
      "id": "ss-002",
      "week": 2,
      "title": "Sample: Serving One Another",
      "theme": "Everyday acts of service",
      "scripture": "Mark 10:42–45; Galatians 5:13–14",
      "memoryVerse": "Galatians 5:13",
      "introduction": "This sample session considers service as a voluntary expression of care rather than a way to gain recognition.",
      "lessonObjectives": [
        "Explain service as care for others",
        "Name gifts that can support a group",
        "Plan one safe and practical act of service"
      ],
      "lessonOutline": [
        "Notice needs without judgment",
        "Offer help with respect",
        "Serve together and reflect"
      ],
      "lessonContent": "Jesus describes leadership through service. Read the passages in a church-approved Bible. Ask learners to distinguish helpful service from taking over or ignoring another person’s wishes. Make a short list of ordinary needs in a household or congregation, then choose an appropriate task that can be done with permission and shared responsibility.",
      "discussionQuestions": [
        "How can we offer help without making assumptions?",
        "What makes teamwork effective?",
        "Which small act of service is realistic this week?"
      ],
      "practicalApplication": "Ask someone what support would actually be useful, then follow through on one agreed task.",
      "conclusion": "Service is most meaningful when it preserves dignity and responds to real needs.",
      "prayer": "God, teach us to serve generously, wisely and with respect for every person. Amen.",
      "contentStatus": "sample"
    },
