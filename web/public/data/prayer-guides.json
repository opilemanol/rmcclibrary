    {
      "id": "pg-001",
      "week": 1,
      "title": "Sample Prayer Guide: Wisdom for the Week",
      "scripture": "James 1:5; Proverbs 3:5–6",
      "introduction": "Use these optional prompts for personal or group prayer. Pause, adapt the words to your situation and respect different needs.",
      "prayerPoints": [
        {
          "title": "Wisdom in decisions",
          "description": "Pray for clarity, patience and good counsel when facing important choices.",
          "scripture": "James 1:5"
        },
        {
          "title": "Care for neighbors",
          "description": "Remember people facing illness, loneliness, financial stress or transition. Ask what practical support is appropriate.",
          "scripture": "Galatians 6:2"
        }
      ],
      "declarations": [
        "We will seek wisdom and listen before acting.",
        "We will offer help with respect and humility."
      ],
      "thanksgiving": "Give thanks for people who offer wise counsel and dependable care.",
      "conclusion": "Close with a quiet moment and choose one practical follow-up action.",
      "contentStatus": "sample"
    },
    {
      "id": "pg-002",
      "week": 2,
      "title": "Sample Prayer Guide: Peace in Our Community",
      "scripture": "Matthew 5:9; Romans 12:18",
      "introduction": "A demonstration guide for praying about peaceful relationships, safety and just treatment in the community.",
      "prayerPoints": [
        {
          "title": "Listen across differences",
          "description": "Pray for courage to listen carefully and speak honestly without demeaning others.",
          "scripture": "Romans 12:18"
        },
        {
          "title": "Support peacemakers",
          "description": "Remember people doing patient work to resolve conflict and protect vulnerable neighbors.",
          "scripture": "Matthew 5:9"
        }
      ],
      "declarations": [
        "We will pursue peace without ignoring harm.",
        "We will seek support from trusted people when conflict is unsafe."
      ],
      "thanksgiving": "Give thanks for those who choose patience, fairness and repair.",
      "conclusion": "Consider one safe step toward understanding or reconciliation.",
      "contentStatus": "sample"
    },
